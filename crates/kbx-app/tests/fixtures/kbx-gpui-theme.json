{
  "name": "kbx",
  "author": "kbx",
  "themes": [
    {
      "name": "kbx Dark",
      "mode": "dark",
      "colors": {
        "accent.background": "#363A4F",
        "accent.foreground": "#CAD3F5",
        "background": "#00000000",
        "base.blue": "#8AADF4",
        "base.blue.light": "#38425F",
        "base.cyan": "#8AADF4",
        "base.cyan.light": "#38425F",
        "base.green": "#A6DA95",
        "base.green.light": "#3E4B4C",
        "base.magenta": "#F5BDE6",
        "base.magenta.light": "#4E455C",
        "base.red": "#ED8796",
        "base.red.light": "#4C3A4C",
        "base.yellow": "#EED49F",
        "base.yellow.light": "#4C4A4E",
        "border": "#363A4F",
        "caret": "#C6A0F6",
        "foreground": "#CAD3F5",
        "input.border": "#363A4F",
        "link.foreground": "#8AADF4",
        "list.active.background": "#7E86A333",
        "list.active.border": "#363A4F",
        "list.background": "#00000000",
        "list.even.background": "#00000000",
        "list.head.background": "#00000000",
        "muted.background": "#191B29",
        "muted.foreground": "#A5ADCB",
        "popover.background": "#1E2030",
        "popover.foreground": "#CAD3F5",
        "progress_bar.background": "#8AADF4",
        "ring": "#C6A0F6",
        "secondary.active.background": "#363A4F",
        "secondary.background": "#2E3248",
        "secondary.foreground": "#CAD3F5",
        "secondary.hover.background": "#363A4F",
        "selection.background": "#C6A0F64D",
        "table.background": "#24273A",
        "title_bar.background": "#24273A",
        "title_bar.border": "#363A4F",
        "window.border": "#363A4F"
      },
      "highlight": {
        "editor.foreground": "#CAD3F5",
        "editor.background": "#191B29",
        "editor.active_line.background": "#363A4F",
        "editor.line_number": "#8086A2",
        "editor.active_line_number": "#A5ADCB",
        "syntax": {
          "attribute": { "color": "#8AADF4" },
          "boolean": { "color": "#F5A97F" },
          "comment": { "color": "#8086A2" },
          "comment.doc": { "color": "#8086A2" },
          "constant": { "color": "#F5A97F" },
          "constructor": { "color": "#C6A0F6" },
          "embedded": { "color": "#CAD3F5" },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },
          "function": { "color": "#8AADF4" },
          "keyword": { "color": "#C6A0F6" },
          "link_text": { "color": "#8AADF4", "font_style": "normal" },
          "link_uri": { "color": "#8AADF4", "font_style": "italic" },
          "number": { "color": "#F5A97F" },
          "operator": { "color": "#A5ADCB" },
          "property": { "color": "#CAD3F5" },
          "punctuation": { "color": "#A5ADCB" },
          "string": { "color": "#A6DA95" },
          "string.escape": { "color": "#EED49F" },
          "string.regex": { "color": "#EED49F" },
          "string.special": { "color": "#A6DA95" },
          "string.special.symbol": { "color": "#A6DA95" },
          "tag": { "color": "#ED8796" },
          "text.literal": { "color": "#A6DA95" },
          "text.code.span": { "color": "#A6DA95" },
          "title": { "color": "#CAD3F5", "font_weight": 600 },
          "type": { "color": "#EED49F" },
          "variable": { "color": "#CAD3F5" },
          "variable.special": { "color": "#ED8796" }
