amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

min_hk_version = "2.0.1"

exclude = List("target", ".git", "tmp", "crates/third-party/block", "crates/third-party/gpui-pre-macos")
display_skip_reasons = List()
terminal_progress = false
fail_fast = false

local binary_excludes = List(
    "*.png", "*.jpg", "*.jpeg", "*.gif", "*.webp", "*.ico",
    "*.woff", "*.woff2", "*.ttf", "*.eot", "*.pdf", "*.zip"
)

// The GitHub token mise resolves, for a tool that reads PINACT_GITHUB_TOKEN (see the pinact step).
local pinact_token = #"PINACT_GITHUB_TOKEN="${PINACT_GITHUB_TOKEN:-${GITHUB_TOKEN:-$(mise token github --raw 2>/dev/null)}}" "#

// Corpora and goldens are authored or generated byte for byte: one owner each, never a formatter.
local generated = List("crates/kbx-domain/tests/fixtures/**/*", "docs/guides/design/**/*", "tools/design/showcase/**/*", "CHANGELOG.md", ".mise/**/*")

// Rust sources and the manifests that decide what they compile against.
local rust_inputs = List("**/*.rs", "**/Cargo.toml", "Cargo.lock", "rust-toolchain.toml", "clippy.toml")

local structure_steps = new Mapping<String, Step> {
  // kbx-domain is the engine and must not reach the UI. Rust already forbids the cycle
  // kbx-app -> kbx-domain -> kbx-app, but nothing stops kbx-domain from depending on gpui
  // directly or through a helper crate, and once it does, the engine carries a
  // UI toolkit. This step is the one owner of that direction.
  //
  // Globbed to kbx-domain's manifest: its dependencies change only there. The workspace root
  // is derived from the manifest's own path, so the tests can build their own workspace
  // under {{tmp}}. --offline: `mise run setup` fetches every crate, so resolution never
  // needs the network, and the tests use path dependencies alone.
  ["domain-purity"] = new Step {
    glob = List("crates/kbx-domain/Cargo.toml")
    shell = "bash -o pipefail -c"
    check = """
      status=0
      for manifest in {{files}}; do
        [[ -f "$manifest" ]] || continue
        root=$(cd "$(dirname "$manifest")/../.." && pwd)
        if ! tree=$(mise exec -- cargo tree --offline --manifest-path "$root/Cargo.toml" -p kbx-domain --edges normal,build --prefix none --format '{p}' 2>&1); then
          echo "$tree"
          status=1
          continue
        fi
        bad=$(printf '%s\\n' "$tree" | awk '{print $1}' | grep -E '^(gpui([-_].*)?|kbx-app)$' | sort -u || true)
        if [[ -n "$bad" ]]; then
          echo "kbx-domain must not depend on UI crates, but reaches:"
          printf '    %s\\n' $bad
          echo "    -> move the UI-dependent code into kbx-app"
          status=1
        fi
      done
      exit $status
      """
    tests {
      ["accepts a domain with no UI dependency"] {
        run = "check"
        files = List("{{tmp}}/crates/kbx-domain/Cargo.toml")
        write {
          ["{{tmp}}/Cargo.toml"] = """
            [workspace]
            resolver = "3"
            members = ["crates/*"]
            """
          ["{{tmp}}/crates/kbx-domain/Cargo.toml"] = """
            [package]
            name = "kbx-domain"
            version = "0.1.0"
            edition = "2024"
            """
          ["{{tmp}}/crates/kbx-domain/src/lib.rs"] = ""
          ["{{tmp}}/crates/gpui/Cargo.toml"] = """
            [package]
            name = "gpui"
            version = "0.1.0"
            edition = "2024"
            """
          ["{{tmp}}/crates/gpui/src/lib.rs"] = ""
        }
        expect { code = 0 }
      }
      ["rejects a direct gpui dependency"] {
        run = "check"
        files = List("{{tmp}}/crates/kbx-domain/Cargo.toml")
        write {
          ["{{tmp}}/Cargo.toml"] = """
            [workspace]
            resolver = "3"
            members = ["crates/*"]
            """
          ["{{tmp}}/crates/kbx-domain/Cargo.toml"] = """
            [package]
            name = "kbx-domain"
            version = "0.1.0"
            edition = "2024"

            [dependencies]
            gpui = { path = "../gpui" }
            """
          ["{{tmp}}/crates/kbx-domain/src/lib.rs"] = ""
          ["{{tmp}}/crates/gpui/Cargo.toml"] = """
            [package]
            name = "gpui"
            version = "0.1.0"
            edition = "2024"
            """
          ["{{tmp}}/crates/gpui/src/lib.rs"] = ""
        }
        expect {
          code = 1
          stdout = "kbx-domain must not depend on UI crates"
        }
      }
      ["rejects gpui reached through another crate"] {
        run = "check"
        files = List("{{tmp}}/crates/kbx-domain/Cargo.toml")
        write {
          ["{{tmp}}/Cargo.toml"] = """
            [workspace]
            resolver = "3"
            members = ["crates/*"]
            """
          ["{{tmp}}/crates/kbx-domain/Cargo.toml"] = """
            [package]
            name = "kbx-domain"
            version = "0.1.0"
            edition = "2024"

            [dependencies]
            helper = { path = "../helper" }
            """
          ["{{tmp}}/crates/kbx-domain/src/lib.rs"] = ""
          ["{{tmp}}/crates/helper/Cargo.toml"] = """
            [package]
            name = "helper"
            version = "0.1.0"
            edition = "2024"

            [dependencies]
            gpui-kit = { path = "../gpui-kit" }
            """
          ["{{tmp}}/crates/helper/src/lib.rs"] = ""
          ["{{tmp}}/crates/gpui-kit/Cargo.toml"] = """
            [package]
            name = "gpui-kit"
            version = "0.1.0"
            edition = "2024"
            """
          ["{{tmp}}/crates/gpui-kit/src/lib.rs"] = ""
        }
        expect {
          code = 1
          stdout = "gpui-kit"
        }
      }
    }
  }
}

local baseline_steps = new Mapping<String, Step> {
    ...structure_steps
    ["newlines"] = (Builtins.newlines) {
        // One owner, the generator: the todo CLI writes TODO.md without a trailing newline, and
        // fixing it by hand only holds until the CLI next writes it.
        exclude = binary_excludes + generated + List("TODO.md")
    }
    ["trailing-whitespace"] = (Builtins.trailing_whitespace) {
        exclude = binary_excludes + generated
    }
    ["merge-conflict"] = Builtins.check_merge_conflict
    ["mixed-line-ending"] = (Builtins.mixed_line_ending) {
        exclude = generated
    }
    ["large-files"] = (Builtins.check_added_large_files) {
        // design:shots commits deliberate 2× screenshots (owner, 2026-10-13, O2).
        exclude = List("tools/design/shots/**")
    }

    ["private-key"] = Builtins.detect_private_key
    ["gitleaks"] = (Builtins.gitleaks) {
        // One gitleaks run over exactly hk's files. `gitleaks dir` takes one path: "." would also read
        // ignored files (target/, tmp/) and fail on them, one run per file took ~100 s,
        // and `gitleaks detect` reads only committed history (it misses a secret not yet committed).
        // So the files are copied to a temporary directory, scanned there once (~0.5 s).
        shell = "bash -o pipefail -c"
        check = #"""
            gitleaks=$(mise which gitleaks); config=$PWD/.gitleaks.toml
            dir=$(mktemp -d); trap 'rm -rf "$dir"' EXIT
            printf '%s\0' {{files}} | tar --null -cf - -T - | tar -xf - -C "$dir"
            cd "$dir" && "$gitleaks" dir --config "$config" --redact --no-banner --log-level error .
            """#
        exclude = binary_excludes
    }

    ["pkl"] = Builtins.pkl
    ["mise"] = Builtins.mise
    ["dprint"] = Builtins.dprint
    ["shellcheck"] = Builtins.shellcheck
    // jactionlint: the maintained fork of actionlint (mise deprecates actionlint); hk has no builtin for it yet.
    ["actionlint"] {
        glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
        check = "mise exec -- jactionlint {{files}}"
    }
    // pinact checks each pinned SHA against GitHub's API: 60 calls an hour without a token, which one run can use
    // up. mise resolves the token (its env vars, the gh keyring) but does not export it to the tools it runs, so the
    // step passes it on, to pinact alone. GITHUB_TOKEN (CI) wins; with no token, pinact runs unauthenticated as before.
    ["pinact"] = (Builtins.pinact) {
        check_diff = pinact_token + "mise exec -- pinact run --verify-comment --check {{files}}"
        fix = pinact_token + "mise exec -- pinact run --verify-comment {{files}}"
    }
    ["typos"] = (Builtins.typos) {
        exclude = binary_excludes + generated + List("*.lock")
    }
    ["docs"] = (Builtins.mdschema) {
        glob = List("README.md")
    }
    ["paths"] {
        check = "mise exec -- ls-lint"
    }
    ["branch"] {
        check = "mise exec -- cchk --branch"
    }

    // Rust: formatter, compiler, linter. The compiler and clippy see the whole workspace,
    // because a change to one crate can break another.
    ["rustfmt"] = (Builtins.cargo_fmt) {
        check = "mise exec -- cargo fmt -- --check"
        fix = "mise exec -- cargo fmt"
    }
    ["taplo"] {
        glob = List("**/*.toml")
        check = "mise exec -- taplo fmt --check {{files}}"
        fix = "mise exec -- taplo fmt {{files}}"
    }
    ["cargo-check"] {
        glob = rust_inputs
        check = "mise exec -- cargo check --workspace --all-targets --locked"
    }
    ["clippy"] {
        glob = rust_inputs
        check = "mise exec -- cargo clippy --workspace --all-targets --locked -- -D warnings"
    }
    ["ast-grep"] {
        glob = List("**/*.rs", "tools/ast-grep/**/*.yml", "sgconfig.yml")
        check = "mise exec -- ast-grep test --skip-snapshot-tests && ast-grep scan"
    }
    ["machete"] {
        glob = List("**/Cargo.toml")
        check = "mise exec -- cargo machete"
    }
    ["dupes"] {
        glob = List("**/*.rs")
        check = "mise exec -- jscpd"
    }
    // Layout guard: a new top-level folder is a deliberate architectural decision.
    ["root-layout"] {
        // `|| true`: grep finds nothing when the layout is clean, and hk runs steps with pipefail.
        check = #"extra=$(git ls-files | cut -s -d/ -f1 | sort -u | grep -v -x -E '\.agents|\.claude|\.github|\.mise|crates|docs|tools' || true); [ -z "$extra" ] || { echo "unexpected top-level folder (README, Project Structure): $extra"; exit 1; }"#
    }

}

// Slow checks. Defined once, spread profile-free into pre-push and profile-gated into `check`.
//
// --no-tests=warn: kbx-domain has no tests until Plan 2. Plan 2's first task removes the flag,
// so an empty test run cannot pass silently once tests exist.
local push_steps = new Mapping<String, Step> {
    ["test"] {
        check = "mise exec -- cargo nextest run --workspace --locked"
    }
    ["build"] {
        check = "mise exec -- cargo build --workspace --release --locked"
    }
}

// Everything a change needs before it is fit to propose.
local candidate_steps = new Mapping<String, Step> {
    ...(push_steps) {
        ["test"] { profiles = List("candidate") }
        ["build"] { profiles = List("candidate") }
    }
    ["rustdoc"] {
        check = "RUSTDOCFLAGS='-D warnings' mise exec -- cargo doc --workspace --no-deps --locked"
        profiles = List("candidate")
    }
    ["coverage"] {
        // A report, not a gate: thresholds come once there is a history to measure them from.
        check = "mise exec -- cargo llvm-cov nextest --workspace --locked --summary-only"
        profiles = List("candidate")
    }
}

// Security and provenance: the concerns that matter once code ships.
local release_steps = new Mapping<String, Step> {
    ["gitleaks-release"] {
        profiles = List("release")
        check = "mise exec -- gitleaks git --redact --no-banner --config=.gitleaks.toml"
    }
    ["cargo-deny"] {
        profiles = List("release")
        check = "mise exec -- cargo deny check"
    }
    // "Small" is one of kbx's goals, so the release binary has a budget
    // (tools/size/budget: the first release build plus 5 %). Raising it is an owner decision.
    ["size-budget"] {
        profiles = List("release")
        check = "mise exec -- cargo build --release --locked -p kbx-app && tools/size/size.sh"
    }
    ["zizmor"] = (Builtins.zizmor) {
        profiles = List("release")
    }
}

local precommit_steps = new Mapping<String, Step> {
    ...(baseline_steps) {
        ["gitleaks"] = (Builtins.gitleaks) {
            // Pre-commit scans the staged index itself, so a secret cannot slip through a
            // glob that stopped matching.
            check = "mise exec -- gitleaks git --pre-commit --redact --staged --verbose --no-banner --log-level error"
        }
    }
}

local all_steps = new Mapping<String, Step> {
    ...baseline_steps
    ...candidate_steps
    ...release_steps
}

local commit_message_steps = new Mapping<String, Step> {
    ["conventional-commit"] {
        check = #"""
            {% raw %}
            f="{% endraw %}{{commit_msg_file}}{% raw %}"
            case "$(grep -v '^#' "$f" | sed -e '/./,$!d' | head -1)" in
                Merge\ *|Revert\ *|Reapply\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
            esac
            mise exec -- quick-commitlint --config .quick-commitlint.json "$f"
            {% endraw %}
            """#
    }
}

// Code graphs (tools/graph/README.md) follow every commit, merge and checkout. The step returns at once and never
// fails git: the update runs in the background.
local graph_refresh_steps = new Mapping<String, Step> {
    ["graph-refresh"] {
        check = "tools/graph/refresh.sh"
        allow_failure = true
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = precommit_steps
    }
    ["commit-msg"] {
        steps = commit_message_steps
    }
    ["pre-push"] {
        steps = push_steps
    }
    ["post-commit"] { steps = graph_refresh_steps }
    ["post-merge"] { steps = graph_refresh_steps }
    ["post-checkout"] { steps = graph_refresh_steps }
    ["fix"] {
        fix = true
        steps = baseline_steps
    }
    ["check"] {
        // Steps that matched no files are absent from HK_REPORT_JSON; a later audit can diff
        // that against the declared set to catch a check that stopped checking anything.
        report = "mkdir -p tmp && printf '%s' \"$HK_REPORT_JSON\" > tmp/hk-report.json"
        steps = all_steps
    }
}
